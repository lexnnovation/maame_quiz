# Required. Encrypts/signs the admin session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Directory where the SQLite database file is stored.
# In Docker/Coolify this should point at a mounted persistent volume.
DATA_DIR=./data

# Optional. Port the Next.js server listens on.
PORT=3000
